# Demo by default. Copy to .env; never commit credentials or local paths.
HERDR_MOBILE_MODE=demo
HERDR_MOBILE_PORT=8787
HERDR_MOBILE_BIND=127.0.0.1
HERDR_MOBILE_HOST_ID=desktop
HERDR_MOBILE_HOST_LABEL=Desktop

# Optional real, READ-ONLY Herdr integration. Use an absolute executable path.
# HERDR_MOBILE_MODE=herdr-readonly
# HERDR_BIN_PATH=C:\Code\herdr\target\release\herdr.exe
# HERDR_SOCKET_PATH=your-exact-local-session-socket-or-pipe

# Direct access from your phone. Use your computer's actual Tailscale IP.
# HERDR_MOBILE_BIND=0.0.0.0
# HERDR_MOBILE_ORIGIN=http://100.64.0.1:8787
# Optional additional address for the same computer on home Wi-Fi:
# HERDR_MOBILE_EXTRA_ORIGINS=http://192.168.178.24:8787
# Trust is provided by your private network/firewall, not an application login.
# Optional HTTPS proxy (needed for in-page microphone recording):
# HERDR_MOBILE_ORIGIN=https://your-desktop.your-tailnet.ts.net
# HERDR_MOBILE_CONFIG=herdr-mobile.config.json

# Optional cloud voice transcription. No API call occurs until you request it.
# OPENAI_API_KEY=...
# HERDR_MOBILE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
